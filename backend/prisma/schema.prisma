// Prisma schema for Postgres/Neon
// Run: npm run prisma:generate
//      npm run prisma:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                     Int       @id @default(autoincrement())
  auth0_id               String    @unique
  email                  String?   @db.VarChar(255)
  name                   String?   @db.VarChar(255)
  picture                String?
  bio                    String?
  user_type              String    @default("alumni")
  graduation_year        Int?
  major                  String?
  current_job            String?
  company                String?
  job_title              String?
  linkedin_url           String?
  github_url             String?
  website_url            String?
  location               String?
  skills                 String?
  is_mentor              Boolean   @default(false)
  registration_completed Boolean   @default(false)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@index([auth0_id], map: "idx_auth0_id")
  @@index([email], map: "idx_email")
  @@index([user_type], map: "idx_user_type")
}

model messages {
  id             Int       @id @default(autoincrement())
  thread_key     String
  sender_email   String
  receiver_email String
  iv             Bytes
  auth_tag       Bytes
  ciphertext     Bytes
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  read_at        DateTime? @db.Timestamptz(6)

  @@index([thread_key], map: "idx_thread_key")
  @@index([sender_email], map: "idx_sender_email")
  @@index([receiver_email], map: "idx_receiver_email")
  @@index([created_at], map: "idx_created_at")
}

model donations {
  id                  Int       @id @default(autoincrement())
  donor_name          String
  donor_email         String
  user_email          String?
  donor_phone         String?
  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @default("INR")
  payment_method      String
  payment_id          String?   @unique
  order_id            String?
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  transaction_status  String    @default("pending")
  donation_type       String    @default("one-time")
  cause_category      String?
  anonymous           Boolean   @default(false)
  message             String?
  description         String?
  receipt_sent        Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([donor_email], map: "idx_donor_email")
  @@index([payment_id], map: "idx_payment_id")
  @@index([transaction_status], map: "idx_transaction_status")
  @@index([created_at], map: "idx_donations_created_at")
}
