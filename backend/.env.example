DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mockapp_db
PORT=4000

# Auth0 (JWT validation and Management API)
AUTH0_DOMAIN=dev-h7qglfwm1ls7s8n1.us.auth0.com
AUTH0_AUDIENCE=https://dev-h7qglfwm1ls7s8n1.us.auth0.com/api/v2/
# Regular Web App client may differ from Management (M2M)
AUTH0_CLIENT_ID=YOUR_WEBAPP_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_WEBAPP_CLIENT_SECRET
# Dedicated M2M credentials recommended for Management API
AUTH0_MGMT_CLIENT_ID=YOUR_M2M_CLIENT_ID
AUTH0_MGMT_CLIENT_SECRET=YOUR_M2M_CLIENT_SECRET

# Encryption for messages at rest
ENCRYPTION_KEY=change-me-please

# RapidAPI JSearch proxy for admin job opportunities
RAPIDAPI_JSEARCH_KEY=your-rapidapi-key
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com

# External jobs cache and rate limiting
JOBS_CACHE_TTL_MINUTES=15
JOBS_RATE_LIMIT_WINDOW_MS=60000
JOBS_RATE_LIMIT_MAX=30
